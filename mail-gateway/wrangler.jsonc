{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "java-core-invite-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["invite@deploro.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
