# Local development config — copy to .env and fill in.
# Production values are set on the hosting environment via env vars / deploro vps set-env.

# Deploro Auth-as-a-Service (base URL + slug from `deploro projects`)
DEPLORO_AUTH_BASE_URL=https://<your-deploro-base-url>
DEPLORO_AUTH_SLUG=<your-project-slug>

# Deploro Studio API — the app's data store (auto-generated REST API per project)
# DEPLORO_API_URL  : https://<deploro-worker>/api/projects/<project-id>/studio
# DEPLORO_API_TOKEN: project-scoped personal access token (`deploro token create`)
DEPLORO_API_URL=
DEPLORO_API_TOKEN=

# AI backend (hosted Ollama-compatible or OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_PROTOCOL=ollama        # ollama | openai

# Bind address for local runs (0.0.0.0 in Docker)
BIND_ADDRESS=127.0.0.1
JAVA_OPTS=-Xmx1g