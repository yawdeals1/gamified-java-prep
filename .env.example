# Local development config — copy to .env and fill in.
# Production values are set on Deploro via: deploro vps set-env <KEY> <VALUE>

# Deploro Auth-as-a-Service (slug from `deploro projects`)
DEPLORO_AUTH_BASE_URL=https://<your-deploro-base-url>
DEPLORO_AUTH_SLUG=<your-project-slug>

# AI backend (hosted Ollama-compatible or OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_PROTOCOL=ollama        # ollama | openai

# Local Postgres (optional — defaults match v1 local setup)
DB_URL=jdbc:postgresql://localhost:5432/gamified_java_prep
DB_USER=postgres
DB_PASSWORD=